# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-key-minimum-256-bits-change-in-production

# MySQL Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=freelance_marketplace
MYSQL_USER=freelance_user
MYSQL_PASSWORD=freelance_pass

# Spring Profiles (h2 for development, mysql for production)
SPRING_PROFILES_ACTIVE=mysql

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api
