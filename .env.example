# Examples only; Spring reads environment variables, not this file automatically.
SPRING_PROFILES_ACTIVE=mysql

# ---- Email (OTP đăng ký / quên mật khẩu / đổi mật khẩu) ----
# auto (mặc định): Brevo nếu có BREVO_API_KEY, ngược lại SMTP nếu có SMTP_HOST.
# log: CHỈ dùng local, không gửi mail mà in mã OTP ra log backend (bị chặn ở profile render).
CAMPUSWORK_EMAIL_PROVIDER=auto
# Người gửi: "Tên <email>" hoặc "email". Với Brevo phải là sender đã verify trong Brevo.
# Với SMTP có thể để trống, khi đó dùng SMTP_USERNAME.
CAMPUSWORK_EMAIL_FROM=
# Cách 1 - Brevo HTTP API (Brevo > SMTP & API > API Keys). Nếu bật Authorized IPs, phải thêm IP server.
BREVO_API_KEY=
# Cách 2 - SMTP. Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USERNAME=<gmail>, SMTP_PASSWORD=<App Password 16 ký tự, cần bật xác minh 2 bước>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

SERVER_PORT=8082
SERVER_SERVLET_CONTEXT_PATH=/api
JWT_SECRET=
UPLOAD_DIRECTORY=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional, only after following docs/MYSQL_WORKBENCH_SETUP.md:
DB_URL=jdbc:mysql://localhost:3306/freelance_marketplace?serverTimezone=Asia/Ho_Chi_Minh&useSSL=true
DB_USERNAME=freelance_app
DB_PASSWORD=
MYSQL_DATABASE=freelance_marketplace
MYSQL_USER=freelance_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Local only, when explicitly enabling demo initialization
APP_DEMO_SEED=false
APP_DEMO_PASSWORD=
