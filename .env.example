# Examples only; Spring reads environment variables, not this file automatically.
SPRING_PROFILES_ACTIVE=dev-h2
SERVER_PORT=8082
SERVER_SERVLET_CONTEXT_PATH=/api
# dev-h2 has a local-only fallback. MySQL requires a secret >=32 bytes.
JWT_SECRET=replace-with-a-long-random-jwt-secret-for-local-use
UPLOAD_DIRECTORY=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional, only after following docs/MYSQL_WORKBENCH_SETUP.md:
DB_URL=jdbc:mysql://localhost:3306/freelance_marketplace?serverTimezone=Asia/Ho_Chi_Minh&useSSL=true
DB_USERNAME=freelance_app
DB_PASSWORD=change-me-local
MYSQL_DATABASE=freelance_marketplace
MYSQL_USER=freelance_app
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local
